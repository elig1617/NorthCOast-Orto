# SmartSuite REST API credentials.
# API key: SmartSuite → your avatar → My Profile → API Key
# Workspace ID: the 8 characters after https://app.smartsuite.com/ in the URL
SMARTSUITE_API_KEY=
SMARTSUITE_WORKSPACE_ID=

# Optional overrides. Defaults come from config/mapping.yaml
# PO_INGEST_MAPPING=config/mapping.yaml
# PO_INGEST_INBOX=data/inbox
